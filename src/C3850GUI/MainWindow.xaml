<ui:FluentWindow x:Class="C3850GUI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:C3850GUI.Views"
                 Title="C3850 GUI"
                 Width="1380" Height="860" MinWidth="980" MinHeight="600"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="C3850 GUI" CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Router24" Filled="True" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <ComboBox x:Name="ProfilePicker" Width="240" Height="30" MinHeight="30" FontSize="12"
                              Padding="8,0" VerticalContentAlignment="Center"
                              DisplayMemberPath="Display" SelectionChanged="ProfilePicker_SelectionChanged" />
                    <ui:Button x:Name="ConnectButton" Margin="8,0,0,0" Height="30" Padding="10,0" FontSize="12"
                               Appearance="Primary" Icon="{ui:SymbolIcon PlugConnected24}" Content="Connect" Click="Connect_Click" />
                    <ui:ProgressRing x:Name="BusyRing" Width="16" Height="16" Margin="12,0,0,0" IsIndeterminate="True" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Not connected" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ui:NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="200" CompactPaneLength="48"
                           IsBackButtonVisible="Collapsed" IsPaneToggleVisible="True" FrameMargin="0"
                           Transition="FadeInWithSlide" TransitionDuration="150">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Dashboard" TargetPageType="{x:Type views:DashboardPage}" Icon="{ui:SymbolIcon Grid24}" />
                <ui:NavigationViewItem Content="Ports" TargetPageType="{x:Type views:PortsPage}" Icon="{ui:SymbolIcon Connector24}" />
                <ui:NavigationViewItem Content="VLANs" TargetPageType="{x:Type views:VlansPage}" Icon="{ui:SymbolIcon BranchFork24}" />
                <ui:NavigationViewItem Content="Stack" TargetPageType="{x:Type views:StackPage}" Icon="{ui:SymbolIcon ServerMultiple20}" />
                <ui:NavigationViewItem Content="PoE" TargetPageType="{x:Type views:PoePage}" Icon="{ui:SymbolIcon Flash24}" />
                <ui:NavigationViewItem Content="MAC Table" TargetPageType="{x:Type views:MacTablePage}" Icon="{ui:SymbolIcon Table24}" />
                <ui:NavigationViewItem Content="Layer 3" TargetPageType="{x:Type views:Layer3Page}" Icon="{ui:SymbolIcon Globe24}" />
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem Content="Command Explorer" TargetPageType="{x:Type views:ExplorerPage}" Icon="{ui:SymbolIcon CompassNorthwest24}" />
                <ui:NavigationViewItem Content="Terminal" TargetPageType="{x:Type views:TerminalPage}" Icon="{ui:SymbolIcon WindowConsole20}" />
                <ui:NavigationViewItem Content="Configuration" TargetPageType="{x:Type views:ConfigPage}" Icon="{ui:SymbolIcon DocumentText24}" />
                <ui:NavigationViewItem Content="Logs" TargetPageType="{x:Type views:LogsPage}" Icon="{ui:SymbolIcon TextBulletListLtr24}" />
                <ui:NavigationViewItem Content="Activity" TargetPageType="{x:Type views:ActivityPage}" Icon="{ui:SymbolIcon History24}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Connections" TargetPageType="{x:Type views:ProfilesPage}" Icon="{ui:SymbolIcon PlugDisconnected24}" />
                <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type views:SettingsPage}" Icon="{ui:SymbolIcon Settings24}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <ui:SnackbarPresenter x:Name="SnackbarHost" Grid.Row="1" VerticalAlignment="Bottom" />
    </Grid>
</ui:FluentWindow>

