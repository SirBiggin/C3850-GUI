<views:SwitchPage x:Class="C3850GUI.Views.PortsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:C3850GUI.Views"
      Title="Ports">
    <Grid Margin="28,20,28,20">
        <Grid.Resources>
            <ContextMenu x:Key="PortMenu">
                <MenuItem Header="Enable  (no shutdown)" Click="Enable_Click" Icon="{ui:SymbolIcon Play24}" />
                <MenuItem Header="Disable  (shutdown)" Click="Disable_Click" Icon="{ui:SymbolIcon Stop24}" />
                <MenuItem Header="Bounce" Click="Bounce_Click" Icon="{ui:SymbolIcon ArrowCounterclockwise24}" />
                <Separator />
                <MenuItem Header="Description…" Click="Desc_Click" Icon="{ui:SymbolIcon Edit24}" />
                <MenuItem Header="Access VLAN…" Click="AccessVlan_Click" Icon="{ui:SymbolIcon BranchFork24}" />
                <MenuItem Header="Trunk / VLANs…" Click="Trunk_Click" Icon="{ui:SymbolIcon BranchFork24}" />
                <MenuItem Header="Port-channel…" Click="PortChannel_Click" Icon="{ui:SymbolIcon Connector24}" />
                <MenuItem Header="PoE…" Click="Poe_Click" Icon="{ui:SymbolIcon Flash24}" />
                <MenuItem Header="Speed / Duplex…" Click="SpeedDuplex_Click" Icon="{ui:SymbolIcon Wrench24}" />
                <MenuItem Header="Custom config…" Click="Custom_Click" Icon="{ui:SymbolIcon Code24}" />
                <MenuItem Header="Default interface" Click="Default_Click" Icon="{ui:SymbolIcon ArrowReset24}" />
                <Separator />
                <MenuItem Header="Details" Click="Details_Click" Icon="{ui:SymbolIcon Info24}" />
                <MenuItem Header="Running config" Click="RunConfig_Click" Icon="{ui:SymbolIcon DocumentText24}" />
                <MenuItem Header="Counters" Click="Counters_Click" Icon="{ui:SymbolIcon Timer24}" />
                <MenuItem Header="Clear counters" Click="ClearCounters_Click" Icon="{ui:SymbolIcon Broom24}" />
                <MenuItem Header="MACs on port" Click="Macs_Click" Icon="{ui:SymbolIcon Search24}" />
            </ContextMenu>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Ports" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Select one or more ports (table or faceplate), then right-click for every action." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ui:TextBox x:Name="FilterBox" Width="220" PlaceholderText="Filter (name, desc, vlan, status)" Icon="{ui:SymbolIcon Search24}" TextChanged="Filter_TextChanged" />
                <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowSync24}" Content="Refresh" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <!-- front panel (built in code: physical layout per stack member) -->
        <ui:Card Grid.Row="1" Padding="12" Margin="0,0,0,10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PanelHost" />
            </ScrollViewer>
        </ui:Card>

        <!-- actions -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Play24}" Content="Enable" Click="Enable_Click" ToolTip="no shutdown" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Stop24}" Content="Disable" Click="Disable_Click" ToolTip="shutdown" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon ArrowCounterclockwise24}" Content="Bounce" Click="Bounce_Click" ToolTip="shutdown, wait, no shutdown" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Edit24}" Content="Description" Click="Desc_Click" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon BranchFork24}" Content="Access VLAN" Click="AccessVlan_Click" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon BranchFork24}" Content="Trunk / VLANs…" Click="Trunk_Click" ToolTip="Trunk with allowed + native VLANs; accepts typed ranges like te2/0/6-7" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Connector24}" Content="Port-channel…" Click="PortChannel_Click" ToolTip="Bundle selected ports into an EtherChannel trunk" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Flash24}" Content="PoE" Click="Poe_Click" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Wrench24}" Content="Speed / Duplex" Click="SpeedDuplex_Click" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon ArrowReset24}" Content="Default" Click="Default_Click" ToolTip="default interface — wipe the port back to factory config" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Code24}" Content="Custom config…" Click="Custom_Click" ToolTip="Send any interface-mode lines to the selected ports" />
            <Separator Margin="6,0,6,6" Width="1" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Info24}" Content="Details" Click="Details_Click" ToolTip="show interfaces X" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon DocumentText24}" Content="Running config" Click="RunConfig_Click" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Timer24}" Content="Counters" Click="Counters_Click" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Broom24}" Content="Clear counters" Click="ClearCounters_Click" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Search24}" Content="MACs on port" Click="Macs_Click" />
        </WrapPanel>

        <DataGrid x:Name="Grid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionChanged="Grid_SelectionChanged" FontSize="12.5" ContextMenu="{StaticResource PortMenu}" PreviewMouseRightButtonDown="Grid_RightClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="28">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><Ellipse Width="9" Height="9" Fill="{Binding Status, Converter={StaticResource PortStatusBrush}}" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Port" Binding="{Binding Name}" Width="110" FontFamily="{StaticResource MonoFont}" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                <DataGridTemplateColumn Header="Mode" Width="90" SortMemberPath="Mode">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="9" Padding="8,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#33555B66" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mode}" Value="trunk"><Setter Property="Background" Value="#552E8BFF" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Mode}" Value="access"><Setter Property="Background" Value="#443FB950" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Mode}" Value="dynamic"><Setter Property="Background" Value="#55E0A030" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Mode}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Mode}" FontSize="11.5" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="VLANs" Binding="{Binding ModeDetail}" Width="200" FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                <DataGridTextColumn Header="Status VLAN" Binding="{Binding Vlan}" Width="80" />
                <DataGridTextColumn Header="Duplex" Binding="{Binding Duplex}" Width="80" />
                <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="80" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</views:SwitchPage>
