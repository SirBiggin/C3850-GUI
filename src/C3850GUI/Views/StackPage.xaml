<views:SwitchPage x:Class="C3850GUI.Views.StackPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:C3850GUI.Views"
      Title="Stack">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,20">
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Stack" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Members, roles, priorities, stack ports, and lifecycle operations." />
                </StackPanel>
                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Icon="{ui:SymbolIcon ArrowSync24}" Content="Refresh" Click="Refresh_Click" />
            </Grid>
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12.5" MaxHeight="260">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="50" />
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100" />
                    <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="150" FontFamily="{StaticResource MonoFont}" />
                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80" />
                    <DataGridTextColumn Header="H/W version" Binding="{Binding Version}" Width="100" />
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,10,0,0">
                <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Edit24}" Content="Set priority" Click="Priority_Click" />
                <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Edit24}" Content="Renumber" Click="Renumber_Click" />
                <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon ArrowCounterclockwise24}" Content="Reload member" Click="ReloadMember_Click" />
                <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon ArrowCounterclockwise24}" Content="Redundancy switchover" Click="Switchover_Click" />
                <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Save24}" Content="Save config" Click="Save_Click" ToolTip="write memory" />
                <ui:Button Margin="0,0,6,6" Appearance="Danger" Icon="{ui:SymbolIcon Power24}" Content="Reload stack" Click="ReloadStack_Click" />
            </WrapPanel>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ui:Card><StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Stack ports" />
                    <TextBox x:Name="StackPorts" Style="{StaticResource MonoOutput}" Height="200" />
                </StackPanel></ui:Card>
                <ui:Card Grid.Column="2"><StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Redundancy" />
                    <TextBox x:Name="Redundancy" Style="{StaticResource MonoOutput}" Height="200" />
                </StackPanel></ui:Card>
            </Grid>
            <ui:Card Margin="0,12,0,0"><StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Environment (temperature, fans, power supplies)" />
                <TextBox x:Name="Env" Style="{StaticResource MonoOutput}" Height="260" />
            </StackPanel></ui:Card>
            <ui:Card Margin="0,12,0,0"><StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Inventory" />
                <TextBox x:Name="Inventory" Style="{StaticResource MonoOutput}" Height="220" />
            </StackPanel></ui:Card>
        </StackPanel>
    </ScrollViewer>
</views:SwitchPage>
