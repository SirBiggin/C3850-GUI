<views:SwitchPage x:Class="C3850GUI.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:C3850GUI.Views"
      Title="Settings">
    <ScrollViewer Padding="28,20,28,20">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Saved automatically." />

            <ui:Card Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Appearance" />
                    <TextBlock Style="{StaticResource Muted}" Text="Theme" />
                    <ComboBox x:Name="ThemeBox" Width="200" HorizontalAlignment="Left" SelectionChanged="Theme_Changed">
                        <ComboBoxItem Content="Dark" /><ComboBoxItem Content="Light" />
                    </ComboBox>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Terminal" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Style="{StaticResource Muted}" Text="Font family" /><ComboBox x:Name="FontBox" IsEditable="True" SelectionChanged="Font_Changed" LostFocus="Font_Changed" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Muted}" Text="Font size" /><ui:NumberBox x:Name="FontSizeBox" Minimum="8" Maximum="28" ValueChanged="FontSize_Changed" /></StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Changes apply the next time a terminal is attached (reconnect or switch sessions)." />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Behaviour" />
                    <ui:ToggleSwitch x:Name="ConfirmToggle" Content="Confirm before sending configuration commands" Checked="Confirm_Changed" Unchecked="Confirm_Changed" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="Log auto-refresh interval (seconds)" />
                    <ui:NumberBox x:Name="RefreshBox" Width="140" HorizontalAlignment="Left" Minimum="5" Maximum="3600" ValueChanged="Refresh_Changed" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="18">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Data" />
                    <TextBlock x:Name="DataPath" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Content="Open data folder" Click="OpenData_Click" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0" Text="C3850 GUI — open source, MIT. github.com/SirBiggin/C3850-GUI" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</views:SwitchPage>
