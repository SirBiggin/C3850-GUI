<views:SwitchPage x:Class="C3850GUI.Views.ProfilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:C3850GUI.Views"
      Title="Connections">
    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Connections" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="One profile per stack management address. Passwords are encrypted with Windows DPAPI for your user account and never leave this machine." />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ListBox x:Name="List" SelectionChanged="List_SelectionChanged" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,10,0" VerticalAlignment="Center" Background="{Binding AccentHex, Converter={StaticResource HexBrush}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Username}" /><Run Text="@" /><Run Text="{Binding Host}" /><Run Text=":" /><Run Text="{Binding Port}" /></TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="New" Click="New_Click" />
                    <ui:Button Margin="6,0,0,0" Icon="{ui:SymbolIcon Copy24}" Content="Duplicate" Click="Dup_Click" />
                    <ui:Button Margin="6,0,0,0" Icon="{ui:SymbolIcon Delete24}" Content="Delete" Click="Delete_Click" />
                </StackPanel>
            </Grid>

            <ui:Card Grid.Column="2" x:Name="Editor" Padding="20" VerticalAlignment="Top" IsEnabled="False">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Profile" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Style="{StaticResource Muted}" Text="Display name" /><ui:TextBox x:Name="NameBox" PlaceholderText="Core stack" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Muted}" Text="Colour" />
                            <ComboBox x:Name="ColorBox" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Blue" Tag="#2E8BFF" /><ComboBoxItem Content="Green" Tag="#3FB950" /><ComboBoxItem Content="Orange" Tag="#E0A030" />
                                <ComboBoxItem Content="Red" Tag="#E54848" /><ComboBoxItem Content="Purple" Tag="#A371F7" /><ComboBoxItem Content="Teal" Tag="#2DD4BF" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Management address" Margin="0,18,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Style="{StaticResource Muted}" Text="Host / IP (management SVI or mgmt port)" /><ui:TextBox x:Name="HostBox" PlaceholderText="10.214.0.2" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Muted}" Text="Port" /><ui:NumberBox x:Name="PortBox" Value="22" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden" /></StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource Muted}" Text="Protocol" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <RadioButton x:Name="ProtoSsh" Content="SSH" IsChecked="True" Checked="Proto_Changed" />
                        <RadioButton x:Name="ProtoTelnet" Content="Telnet  (cleartext — lab use only)" Margin="18,0,0,0" Checked="Proto_Changed" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Credentials" Margin="0,18,0,8" />
                    <StackPanel><TextBlock Style="{StaticResource Muted}" Text="Username" /><ui:TextBox x:Name="UserBox" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                        <RadioButton x:Name="AuthPw" Content="Password" IsChecked="True" Checked="Auth_Changed" />
                        <RadioButton x:Name="AuthKey" Content="SSH private key" Margin="18,0,0,0" Checked="Auth_Changed" />
                    </StackPanel>
                    <StackPanel x:Name="PwPanel">
                        <TextBlock Style="{StaticResource Muted}" Text="Password" />
                        <ui:PasswordBox x:Name="PwBox" RevealButtonEnabled="True" />
                    </StackPanel>
                    <StackPanel x:Name="KeyPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Muted}" Text="Private key file (OpenSSH / PEM)" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="KeyBox" PlaceholderText="C:\Users\you\.ssh\id_ecdsa" />
                            <ui:Button Grid.Column="1" Margin="6,0,0,0" Content="Browse…" Click="BrowseKey_Click" />
                        </Grid>
                        <TextBlock Style="{StaticResource Muted}" Text="Key passphrase (if any)" Margin="0,8,0,0" />
                        <ui:PasswordBox x:Name="KeyPassBox" RevealButtonEnabled="True" />
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource Muted}" Text="Enable secret (leave blank to reuse the password, or if your user lands in privileged mode already)" TextWrapping="Wrap" />
                        <ui:PasswordBox x:Name="EnableBox" RevealButtonEnabled="True" />
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource Muted}" Text="Front panel: ports per faceplate group (C3850 = 12; 0 = no gaps). Stacked vs single-row is chosen per member on the Ports page." TextWrapping="Wrap" />
                        <ui:NumberBox x:Name="GroupBox" Width="120" HorizontalAlignment="Left" Minimum="0" Maximum="64" SpinButtonPlacementMode="Hidden" />
                    </StackPanel>
                    <StackPanel Margin="0,14,0,0"><TextBlock Style="{StaticResource Muted}" Text="Notes" /><ui:TextBox x:Name="NotesBox" AcceptsReturn="True" MinHeight="50" TextWrapping="Wrap" /></StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Content="Save" Click="Save_Click" />
                        <ui:Button Margin="6,0,0,0" Icon="{ui:SymbolIcon PlugConnected24}" Content="Save &amp; connect" Click="SaveConnect_Click" />
                        <ui:Button Margin="6,0,0,0" Content="Test connection" Click="Test_Click" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</views:SwitchPage>
