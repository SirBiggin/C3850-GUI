<views:SwitchPage x:Class="C3850GUI.Views.PoePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:C3850GUI.Views"
      Title="PoE">
    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Power over Ethernet" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Budget per stack member and per-port draw from 'show power inline'." />
            </StackPanel>
            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Icon="{ui:SymbolIcon ArrowSync24}" Content="Refresh" Click="Refresh_Click" />
        </Grid>
        <ItemsControl x:Name="Modules" Grid.Row="1">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource StatCard}" MinWidth="230">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}"><Run Text="SWITCH " /><Run Text="{Binding Module}" /></TextBlock>
                            <TextBlock Style="{StaticResource StatValue}"><Run Text="{Binding Used}" /><Run Text=" W" FontSize="14" /></TextBlock>
                            <ProgressBar Value="{Binding Used, Mode=OneWay}" Maximum="{Binding Available, Mode=OneWay}" Height="6" Margin="0,6,0,4" />
                            <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Remaining}" /><Run Text=" W remaining of " /><Run Text="{Binding Available}" /></TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Play24}" Content="Auto" Click="Auto_Click" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Stop24}" Content="Never (off)" Click="Never_Click" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon ArrowCounterclockwise24}" Content="Power-cycle device" Click="Cycle_Click" ToolTip="power inline never, then auto" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Info24}" Content="Detail" Click="Detail_Click" />
            <ui:Button Margin="0,0,6,6" Icon="{ui:SymbolIcon Info24}" Content="Police / consumption" Click="Police_Click" />
        </WrapPanel>
        <DataGrid x:Name="Grid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12.5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Interface" Binding="{Binding Interface}" Width="110" FontFamily="{StaticResource MonoFont}" />
                <DataGridTextColumn Header="Admin" Binding="{Binding Admin}" Width="80" />
                <DataGridTextColumn Header="Oper" Binding="{Binding Oper}" Width="90" />
                <DataGridTextColumn Header="Power (W)" Binding="{Binding Power}" Width="90" />
                <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="*" />
                <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="70" />
                <DataGridTextColumn Header="Max (W)" Binding="{Binding Max}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</views:SwitchPage>
