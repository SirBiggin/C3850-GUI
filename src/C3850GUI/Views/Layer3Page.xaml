<views:SwitchPage x:Class="C3850GUI.Views.Layer3Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:C3850GUI.Views"
      Title="Layer 3">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,20">
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Layer 3" />
                    <TextBlock x:Name="Sub" Style="{StaticResource PageSubtitle}" Text="IP interfaces, routing, DHCP server and relay." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Border x:Name="RoutingPill" CornerRadius="10" Padding="10,3" Background="#33555B66" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="RoutingText" Text="ip routing: ?" FontSize="12" />
                    </Border>
                    <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="Refresh" Click="Refresh_Click" />
                </StackPanel>
            </Grid>

            <!-- IP interfaces -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="IP interfaces (SVIs and routed ports)" Margin="0" />
                        <WrapPanel HorizontalAlignment="Right">
                            <ui:Button Margin="0,0,6,0" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="New SVI…" Click="NewSvi_Click" />
                            <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Edit24}" Content="Set IP…" Click="SetIp_Click" />
                            <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon ArrowRouting24}" Content="DHCP relay (helper)…" Click="Helper_Click" />
                            <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Play24}" Content="No shut" Click="IfUp_Click" />
                            <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Stop24}" Content="Shut" Click="IfDown_Click" />
                            <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon DocumentText24}" Content="Running config" Click="IfConfig_Click" />
                            <ui:Button Icon="{ui:SymbolIcon Delete24}" Content="Delete SVI" Click="DeleteSvi_Click" />
                        </WrapPanel>
                    </Grid>
                    <DataGrid x:Name="IfGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12.5" MaxHeight="280">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Interface" Binding="{Binding Name}" Width="160" FontFamily="{StaticResource MonoFont}" />
                            <DataGridTextColumn Header="IP address" Binding="{Binding Ip}" Width="170" FontFamily="{StaticResource MonoFont}" />
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="90" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="190" />
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="90" />
                            <DataGridTextColumn Header="Helper addresses" Binding="{Binding Helpers}" Width="*" FontFamily="{StaticResource MonoFont}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ui:Card>

            <!-- Routing -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Routing" Margin="0" />
                        <WrapPanel HorizontalAlignment="Right">
                            <ui:Button Margin="0,0,6,0" x:Name="RoutingToggle" Content="Enable ip routing" Click="RoutingToggle_Click" />
                            <ui:Button Margin="0,0,6,0" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Add static route…" Click="AddRoute_Click" />
                            <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Delete24}" Content="Remove static route…" Click="DelRoute_Click" />
                            <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Info24}" Content="Full table" Click="FullRoute_Click" />
                            <ui:Button Icon="{ui:SymbolIcon Info24}" Content="Protocols" Click="Protocols_Click" />
                        </WrapPanel>
                    </Grid>
                    <TextBox x:Name="Routes" Style="{StaticResource MonoOutput}" Height="180" />
                </StackPanel>
            </ui:Card>

            <!-- DHCP -->
            <ui:Card>
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="DHCP server" Margin="0" />
                        <WrapPanel HorizontalAlignment="Right">
                            <ui:Button Margin="0,0,6,0" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="New pool…" Click="NewPool_Click" />
                            <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Edit24}" Content="Edit pool…" Click="EditPool_Click" />
                            <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Delete24}" Content="Delete pool" Click="DelPool_Click" />
                            <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Add24}" Content="Exclude range…" Click="Exclude_Click" />
                            <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Add24}" Content="Static binding…" Click="StaticBind_Click" />
                            <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Info24}" Content="Bindings" Click="Bindings_Click" />
                            <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Info24}" Content="Conflicts" Click="Conflicts_Click" />
                            <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Broom24}" Content="Clear binding…" Click="ClearBinding_Click" />
                            <ui:Button Icon="{ui:SymbolIcon DocumentText24}" Content="DHCP config" Click="DhcpConfig_Click" />
                        </WrapPanel>
                    </Grid>
                    <DataGrid x:Name="PoolGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="12.5" MaxHeight="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pool" Binding="{Binding Name}" Width="180" />
                            <DataGridTextColumn Header="Range" Binding="{Binding Range}" Width="260" FontFamily="{StaticResource MonoFont}" />
                            <DataGridTextColumn Header="Leased" Binding="{Binding Leased}" Width="80" />
                            <DataGridTextColumn Header="Excluded" Binding="{Binding Excluded}" Width="90" />
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="80" />
                            <DataGridTemplateColumn Header="Utilisation" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ProgressBar Value="{Binding Leased, Mode=OneWay}" Maximum="{Binding Usable, Mode=OneWay}" Height="6" Margin="0,0,12,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="ExcludedText" Style="{StaticResource Muted}" Margin="0,8,0,0" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</views:SwitchPage>
